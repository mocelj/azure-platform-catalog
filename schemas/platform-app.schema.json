{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:avm-demo:platform-app:1.0",
  "title": "Developer request for a platform app",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platformApp", "name", "environment", "size"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "platformApp": { "enum": ["storage", "vm", "web-app", "container-app"] },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,19}$" },
    "environment": { "const": "demo" },
    "size": { "enum": ["small", "medium"] }
  }
}
